# Factus Pay Sandbox credentials (replace locally; never commit real values)
FACTUS_PAY_EMAIL=your-sandbox-email@example.com
FACTUS_PAY_PASSWORD=replace-with-your-sandbox-password

# Generate a unique random secret for the Factus Pay webhook
FACTUS_WEBHOOK_KEY=replace-with-a-generated-random-secret

# QR validity in seconds (60 to 86400)
FACTUS_QR_EXPIRATION_SECONDS=1200

# Local-only order storage directory
SIRIUS_DATA_DIR=./data
